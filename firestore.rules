rules_version = '2';

// Lead storage rules for the portfolio site.
// 1. Create your admin user in Firebase Console → Authentication → Users.
// 2. Copy its User UID and paste it below in place of REPLACE_WITH_YOUR_ADMIN_UID.
// 3. Publish these rules in Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == "REPLACE_WITH_YOUR_ADMIN_UID";
    }

    function str(field, min, max) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() >= min
        && request.resource.data[field].size() <= max;
    }

    match /leads/{leadId} {
      // Anyone can submit a lead, but only in the exact expected shape.
      allow create: if request.resource.data.keys().hasOnly([
            "name", "company", "role", "hiringType", "workMode", "location", "budget",
            "timeline", "problem", "email", "phone", "source", "status", "notes",
            "score", "createdAt", "updatedAt"])
        && str("name", 2, 200) && str("company", 0, 200) && str("role", 0, 200)
        && str("hiringType", 0, 200) && str("workMode", 0, 200) && str("location", 0, 200)
        && str("budget", 0, 200) && str("timeline", 0, 200) && str("problem", 0, 4000)
        && str("email", 0, 200) && str("phone", 0, 200)
        && (request.resource.data.email.size() > 0 || request.resource.data.phone.size() > 0)
        && request.resource.data.source in ["chatbot", "contact-form"]
        && request.resource.data.status == "new"
        && request.resource.data.notes == ""
        && request.resource.data.score in ["HOT", "WARM", "COLD"]
        && str("createdAt", 10, 40) && str("updatedAt", 10, 40);

      // Only you can read, update or delete leads.
      allow read, update, delete: if isAdmin();
    }
  }
}
